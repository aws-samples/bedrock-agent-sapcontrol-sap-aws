{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "SAPControlLambda1",
            "Effect": "Allow",
            "Action": [
                "ssm:GetParameterHistory",
                "ssm:GetParameters",
                "ssm:GetParameter"
            ],
            "Resource": "arn:aws:ssm:*:<accountnumber>:parameter/*"
        },
        {
            "Sid": "SAPControlLambda2",
            "Effect": "Allow",
            "Action": "ssm:DescribeParameters",
            "Resource": "*"
        }
    ]
}
